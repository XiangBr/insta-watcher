# ============================================================
# insta-watcher: configuração (apenas placeholders)
#
# O jeito fácil: ./scripts/setup.sh escreve este arquivo como .env,
# gera os segredos e sobe tudo. Para fazer à mão: cp .env.example .env
# e preencha. Nunca coloque valores reais neste arquivo de exemplo.
#
# A API recusa subir se um segredo obrigatório estiver ausente,
# curto ou parecer um exemplo. Variável vazia = desligada.
# ============================================================

# ---------- Como publicar (docs/deploy.md) ----------

# Serviços extras do docker compose. "web" é o painel. Some "tunnel" para um túnel
# rápido da Cloudflare, ou "named-tunnel" para um túnel fixo. Sem "web" = painel na Vercel.
COMPOSE_PROFILES=web

# Endereço que o gateway atende.
#   insta.seudominio.com  -> HTTPS automático (as portas 80 e 443 precisam chegar aqui)
#   :80                   -> HTTP simples, para um proxy ou túnel na frente
SITE_ADDRESS=:80
# Onde o gateway escuta no host. Com domínio próprio: 0.0.0.0:80 e 0.0.0.0:443.
# Atrás de um proxy ou túnel: deixe em 127.0.0.1.
HTTP_BIND=127.0.0.1:8080
HTTPS_BIND=127.0.0.1:8443

# Endereço público com HTTPS (o que a Meta chama). Usado para conferir a instalação
# (./scripts/iw doctor) e imprimir as URLs que vão no app da Meta.
PUBLIC_URL=

# Só com o painel na Vercel: abre a API de admin no gateway (ela continua exigindo
# API_ADMIN_TOKEN). Fora isso, deixe comentado: a API de admin fica só na rede interna.
# ADMIN_API_HANDLER=reverse_proxy api:8000

# Túnel fixo da Cloudflare (perfil "named-tunnel"). Zero Trust > Networks > Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# ---------- App da Meta (docs/meta-setup.md) ----------

# Segredo do app (Configurações do app > Básico > Chave secreta do app).
META_APP_SECRET=
# Segredo do app do Instagram (Instagram > Configuração da API com login do Instagram).
INSTAGRAM_APP_SECRET=
# String aleatória. A mesma que você cola no webhook do app na Meta.
# openssl rand -hex 24
WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0

# Contato público nas páginas /privacy, /terms e /data-deletion. A Meta exige essas
# páginas para publicar o app. Sem valor, elas respondem 404.
LEGAL_CONTACT_EMAIL=

# ---------- Segredos gerados (setup.sh gera todos) ----------

# Criptografa o token do Instagram no banco. 64 caracteres hex. NUNCA troque depois de
# guardar o token: ele fica ilegível e precisa ser colado de novo.
# openssl rand -hex 32
ENCRYPTION_KEY=
# Token que o painel usa para falar com a API. openssl rand -hex 32
API_ADMIN_TOKEN=
# Sal dos hashes de IP. openssl rand -hex 32
CLICK_HASH_SALT=
# Assina o cookie de sessão do painel. openssl rand -hex 32
SESSION_SECRET=
# Hash argon2id da senha do painel, entre aspas simples (o $ não pode ser interpretado):
#   docker compose run --rm --no-deps web node scripts/hash-password.mjs
# Na Vercel, cole o hash sem aspas.
ADMIN_PASSWORD_HASH=

# ---------- Módulos opcionais ----------

# Concorrência: coleta de perfis públicos. console.apify.com > Settings > API & Integrations
APIFY_TOKEN=
# I.A.: classificação (JEV), relatório de concorrência e respostas no direct.
# openrouter.ai/keys. A I.A. do direct ainda precisa ser ligada no painel.
OPENROUTER_API_KEY=
# Confira os slugs em openrouter.ai/models
COMPETITORS_REPORT_MODEL=anthropic/claude-sonnet-5.5
CHAT_AI_MODEL=anthropic/claude-haiku-5.5
JEV_MODEL=typesafe/jev-1.14

# ---------- Ajustes (os padrões servem para quase todo mundo) ----------

# Fuso dos dias nos insights, em minutos. -180 é Brasília.
INSIGHTS_UTC_OFFSET_MINUTES=-180
# Pode ser baixado (se a Meta limitar antes), nunca subido acima de 750.
PRIVATE_REPLY_HOURLY_LIMIT=750
# Retenção, em dias. A política de privacidade publicada promete estes prazos.
RETENTION_WEBHOOK_DAYS=7
RETENTION_DELIVERY_DAYS=90
RETENTION_OPS_DAYS=90

# Outros (docs/architecture.md):
# WORKER_CONCURRENCY=3
# RECONCILE_INTERVAL_SECONDS=300
# RECONCILE_LOOKBACK_HOURS=72
# RECONCILE_MAX_PER_SWEEP=30
# TOKEN_REFRESH_WHEN_DAYS=20
# INSIGHTS_SYNC_INTERVAL_SECONDS=10800
# INSIGHTS_MAX_CALLS_PER_SYNC=200
# INSIGHTS_BACKFILL_DAYS=90
# INSIGHTS_COMMENT_DAYS=90
# COMPETITORS_REFRESH_HOURS=168
# COMPETITORS_MAX=30
# COMPETITORS_CLASSIFY_PER_RUN=60
# CHAT_INTERVAL_SECONDS=2
# WEBHOOK_MAX_BODY_BYTES=262144
# ENABLE_API_DOCS=false

# ---------- Rodar sem Docker (desenvolvimento) ----------
# O compose define estes dois. Para `uv run uvicorn` e `pnpm dev` locais:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db
# API_BASE_URL=http://localhost:8000
